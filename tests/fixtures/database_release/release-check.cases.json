{
  "format": "ai-engineer-release-check-cases/1",
  "about": "Shared cases for the startup check every service runs against api.database_release() (VER-S1). Each consumer implements the same two rules in its own language and runs these cases in its tests. A range is an exact version (X.Y.Z) or '>=A.B.C <D.E.F'. 'start' says whether a service in enforce mode starts.",
  "range": [
    { "version": "0.12.0", "range": "0.12.0", "in": true },
    { "version": "0.12.1", "range": "0.12.0", "in": false },
    { "version": "0.11.0", "range": "0.12.0", "in": false },
    { "version": "1.2.0", "range": ">=1.2.0 <2.0.0", "in": true },
    { "version": "1.10.3", "range": ">=1.2.0 <2.0.0", "in": true },
    { "version": "1.1.9", "range": ">=1.2.0 <2.0.0", "in": false },
    { "version": "2.0.0", "range": ">=1.2.0 <2.0.0", "in": false }
  ],
  "verdict": [
    { "name": "the database gave no answer", "observed": null, "range": "0.12.0", "verdict": "unknown", "start": false, "warning": false },
    { "name": "an answer in another format", "observed": { "format": "something-else/9", "release": "0.12.0", "state": "current" }, "range": "0.12.0", "verdict": "unknown", "start": false, "warning": false },
    { "name": "never stamped", "observed": { "format": "ai-engineer-database-release/1", "release": null, "state": "unstamped" }, "range": "0.12.0", "verdict": "unstamped", "start": false, "warning": false },
    { "name": "an earlier release", "observed": { "format": "ai-engineer-database-release/1", "release": "0.11.0", "state": "current" }, "range": "0.12.0", "verdict": "incompatible", "start": false, "warning": false },
    { "name": "a later release outside the range", "observed": { "format": "ai-engineer-database-release/1", "release": "2.0.0", "state": "current" }, "range": ">=1.2.0 <2.0.0", "verdict": "incompatible", "start": false, "warning": false },
    { "name": "behind its own stamp", "observed": { "format": "ai-engineer-database-release/1", "release": "0.12.0", "state": "inconsistent" }, "range": "0.12.0", "verdict": "inconsistent", "start": false, "warning": false },
    { "name": "the release, as stamped", "observed": { "format": "ai-engineer-database-release/1", "release": "0.12.0", "state": "current" }, "range": "0.12.0", "verdict": "ok", "start": true, "warning": false },
    { "name": "a later minor inside the range", "observed": { "format": "ai-engineer-database-release/1", "release": "1.5.0", "state": "current" }, "range": ">=1.2.0 <2.0.0", "verdict": "ok", "start": true, "warning": false },
    { "name": "unreleased migrations on top (a lab during a unit session)", "observed": { "format": "ai-engineer-database-release/1", "release": "0.12.0", "state": "ahead" }, "range": "0.12.0", "verdict": "ok", "start": true, "warning": true },
    { "name": "a component differs from its pin", "observed": { "format": "ai-engineer-database-release/1", "release": "0.12.0", "state": "component_drift" }, "range": "0.12.0", "verdict": "ok", "start": true, "warning": true },
    { "name": "the migration list cannot be read", "observed": { "format": "ai-engineer-database-release/1", "release": "0.12.0", "state": "unverifiable" }, "range": "0.12.0", "verdict": "ok", "start": true, "warning": true }
  ],
  "mode": {
    "variable": "AIENG_DB_RELEASE_CHECK",
    "values": {
      "enforce": "the default: the service starts only when 'start' is true, and logs the warning when 'warning' is true",
      "warn": "the service always starts and logs the verdict",
      "off": "the service does not ask the database"
    }
  }
}
