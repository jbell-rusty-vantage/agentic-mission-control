{
  "$id": "https://belllabs.local/knowledge-operation-protocol/research-report-package.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "research-report-package.v2"
    },
    "report": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "report"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest",
        "tenant",
        "binding"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
    },
    "kind": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "report_kind"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest",
        "tenant",
        "binding"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "The receiver's declared purpose; recorded with the read, never a use decision."
    },
    "request": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "selectedReadDigest of the exact request this package answers."
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "revision"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "members"
            },
            "assertions": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "assertion"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "tenant": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "binding": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "version",
                  "digest",
                  "tenant",
                  "binding"
                ],
                "additionalProperties": false
              },
              "description": "Exact assertion handles of the revision, sorted by id, one per id."
            },
            "evidence": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "fragment"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "tenant": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "binding": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "version",
                  "digest",
                  "tenant",
                  "binding"
                ],
                "additionalProperties": false
              },
              "description": "Exact fragment handles of the revision, sorted by id, one per id."
            }
          },
          "required": [
            "mode",
            "assertions",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "body": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "enum": [
                "body.md",
                "ledger.json"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "artifact": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "artifact"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "tenant": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "binding": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                }
              },
              "required": [
                "kind",
                "id",
                "version",
                "digest",
                "tenant",
                "binding"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "path",
            "digest",
            "bytes",
            "artifact"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ledger": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "enum": [
                "body.md",
                "ledger.json"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "artifact": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "artifact"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "tenant": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "binding": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
                }
              },
              "required": [
                "kind",
                "id",
                "version",
                "digest",
                "tenant",
                "binding"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "path",
            "digest",
            "bytes",
            "artifact"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "assertion"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "tenant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "binding": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              }
            },
            "required": [
              "kind",
              "id",
              "version",
              "digest",
              "tenant",
              "binding"
            ],
            "additionalProperties": false
          },
          "record": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "handle",
          "record"
        ],
        "additionalProperties": false,
        "description": "One selected assertion: its exact handle and the immutable record whose kop-canonical-json.v1 digest is the handle digest."
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "fragment"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "tenant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "binding": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
              }
            },
            "required": [
              "kind",
              "id",
              "version",
              "digest",
              "tenant",
              "binding"
            ],
            "additionalProperties": false
          },
          "record": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "handle",
          "record"
        ],
        "additionalProperties": false,
        "description": "One selected fragment: its exact handle and the immutable record whose kop-canonical-json.v1 digest is the handle digest."
      }
    }
  },
  "required": [
    "schema",
    "report",
    "revision",
    "kind",
    "purpose",
    "request",
    "selection",
    "body",
    "ledger",
    "assertions",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
