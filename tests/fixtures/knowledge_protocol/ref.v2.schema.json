{
  "$id": "https://belllabs.local/knowledge-operation-protocol/ref.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "artifact",
        "assertion",
        "occurrence",
        "fragment",
        "support_set",
        "observation",
        "report",
        "report_kind",
        "rubric",
        "policy",
        "method",
        "mapping",
        "verification_run",
        "run_manifest",
        "use_decision",
        "adjudication",
        "receipt",
        "effect",
        "operation"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "binding": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
    }
  },
  "required": [
    "kind",
    "id",
    "version",
    "digest",
    "tenant",
    "binding"
  ],
  "additionalProperties": false
}
