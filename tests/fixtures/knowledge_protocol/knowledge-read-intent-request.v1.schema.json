                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "const": "schema_search"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
