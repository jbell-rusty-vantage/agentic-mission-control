{
  "$id": "https://belllabs.local/knowledge-operation-protocol/knowledge-plan-preview.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "semanticPayloadDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundEffectDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "normalizedValuesDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "processedEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "migrationHead": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "planId",
    "semanticPayloadDigest",
    "boundEffectDigest",
    "normalizedValuesDigest",
    "processedEpoch",
    "migrationHead"
  ],
  "additionalProperties": false
}
