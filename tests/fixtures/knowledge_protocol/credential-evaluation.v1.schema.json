{
  "$id": "https://belllabs.local/knowledge-operation-protocol/credential-evaluation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "judge",
        "second_family_judge",
        "auditor",
        "human_reviewer"
      ]
    },
    "credentialRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "family": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "role",
    "credentialRef",
    "provider",
    "family"
  ],
  "additionalProperties": false
}
