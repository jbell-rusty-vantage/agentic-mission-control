{
  "mcpServers": {
    "mc-agent-browser": {
      "args": [
        "mcp",
        "--tools",
        "core"
      ],
      "command": "agent-browser",
      "type": "stdio"
    },
    "mc-firecrawl": {
      "headers": {
        "Authorization": "Bearer ${env:FIRECRAWL_API_KEY}"
      },
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp"
    },
    "mc-tavily": {
      "args": [
        "-y",
        "tavily-mcp@0.2.22"
      ],
      "command": "npx",
      "env": {
        "TAVILY_API_KEY": "${env:TAVILY_API_KEY}"
      },
      "type": "stdio"
    }
  }
}
