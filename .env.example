# PRE-EMPTIVE SETUP: copy only missing names into .env; never commit real values.
DATABASE_DIRECT=
DATABASE_URL=
# Application-owned run-control PostgreSQL. Never point this at Temporal persistence.
APPLICATION_DATABASE_DIRECT=postgresql://belllabs_app:belllabs-app-local@127.0.0.1:55432/belllabs
APPLICATION_DATABASE_URL=
# Production uses a distinct schema-owner credential for migrations.
APPLICATION_MIGRATION_DATABASE_DIRECT=postgresql://belllabs:belllabs-local@127.0.0.1:55432/belllabs
# Dedicated login holding only belllabs_family_repository_writer; required for atomic family writes.
APPLICATION_FAMILY_WRITER_DATABASE_DIRECT=
# Dedicated member of belllabs_operation_backfill; never reuse the runtime credential.
APPLICATION_BACKFILL_DATABASE_DIRECT=
APPLICATION_POSTGRES_PORT=55432
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4.5
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
# LangSmith observability (optional; enabled when LANGSMITH_TRACING=true and key is set).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Required fail-closed baseline before Agent Server tracing may be enabled.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=BellLabsBiotech
AGENT_SERVER_LANGSMITH_PROJECT=BellLabsBiotech-AgentServer-Local
BELL_LABS_TRACE_PSEUDONYM_KEY=
# Required only for org-scoped API keys.
LANGSMITH_WORKSPACE_ID=
# Standard Agent Server is opt-in until the runtime cutover gate passes.
LANGGRAPH_RUNTIME_ENABLED=false
BELL_LABS_ENVIRONMENT=development
AGENT_SERVER_GOAL_DIRECTED_ID=belllabs_goal_directed
AGENT_SERVER_DEPLOYMENT_ENDPOINT_ID=
AGENT_SERVER_DEPLOYMENT_REVISION=
# Supabase defaults: issuer ${SUPABASE_URL}/auth/v1 and audience authenticated.
BELL_LABS_AGENT_AUTH_ISSUER=
BELL_LABS_AGENT_AUTH_AUDIENCE=authenticated
BELL_LABS_AGENT_AUTH_JWKS_URI=
BELL_LABS_AGENT_AUTH_PUBLIC_KEY=
BELL_LABS_AGENT_AUTH_ALGORITHM=RS256
# Coordinator discovery and launch surfaces are opt-in.
COORDINATOR_MCP_ENABLED=false
COORDINATOR_MCP_MOUNT_PATH=/mcp/coordinator
# Defaults to ${SUPABASE_URL}/auth/v1 when empty.
COORDINATOR_MCP_JWT_ISSUER=
COORDINATOR_MCP_JWT_AUDIENCE=authenticated
COORDINATOR_STANDALONE_MODE=read-only
COORDINATOR_REQUEST_TIMEOUT_SECONDS=30
COORDINATOR_MAX_REQUEST_BYTES=131072
COORDINATOR_MAX_RESPONSE_BYTES=1000000
COORDINATOR_MAX_CONCURRENCY=16
COORDINATOR_REQUESTS_PER_MINUTE=120
CAPABILITY_SEARCH_ENABLED=false
EXTERNAL_CAPABILITY_DISCOVERY_ENABLED=false
COORDINATOR_LAUNCH_ENABLED=false
CAPABILITY_EMBEDDING_MODEL=text-embedding-3-small
CAPABILITY_EMBEDDING_DIMENSIONS=1536
CAPABILITY_PROJECTION_LEASE_SECONDS=120
CAPABILITY_PROJECTION_MAX_ATTEMPTS=6
CAPABILITY_PROJECTION_BASE_BACKOFF_SECONDS=5
CAPABILITY_PROJECTION_MAX_BACKOFF_SECONDS=900
CAPABILITY_PROJECTION_BATCH_SIZE=64
COORDINATOR_LAUNCH_TICKET_TTL_SECONDS=900
EXTERNAL_DISCOVERY_REQUEST_TIMEOUT_SECONDS=10
EXTERNAL_DISCOVERY_COMMAND_TIMEOUT_SECONDS=30
EXTERNAL_DISCOVERY_MAX_OUTPUT_BYTES=1000000
EXTERNAL_DISCOVERY_MAX_RESULTS=25
EXTERNAL_DISCOVERY_MAX_PAGES=5
EXTERNAL_DISCOVERY_MAX_RETRIES=2
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io
MCP_REGISTRY_API_VERSION=v0.1
# Exact SemVer only. Floating tags and ranges are rejected by Settings.
NPX_SKILLS_PACKAGE_VERSION=1.5.20
NPX_SKILLS_EXECUTABLE=npx
# Host-mapped away from 6379 (WSL/local Redis) and Windows excluded ranges near 56xxx.
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0
RUNTIME_REALTIME_REQUIRED=false
RUNTIME_APPROVAL_TIMEOUT_SECONDS=900
RUNTIME_CHECKPOINT_SIGNING_KEY=
NEO4J_URI=
NEO4J_AURA_USERNAME=
NEO4J_AURA_PASSWORD=
# Distinct service identities; operator approval is never substituted for these authorities.
SCHEMA_DEPLOYMENT_ISSUER_AUTHORITY_REF=issue-12:graph-schema-deployment-service
SCHEMA_WORKSPACE_ISSUER_AUTHORITY_REF=issue-13:schema-workspace-materialization-service
GRAPH_CAPABILITY_AUTHORITY_REF=graph-authority:read-capability-service
SCHEMA_WORKSPACE_MATERIALIZER_VERSION=issue-13-materializer-v1
AWS_REGION=us-east-1
AWS_PROFILE=default
S3_BUCKET=
# S3-compatible object store (Supabase Storage: <project-url>/storage/v1/s3; local stack:
# http://127.0.0.1:<api-port>/storage/v1/s3). Unset: AWS S3. The explicit keys (Supabase:
# Storage > S3 access keys; local: `supabase status`) take precedence over AWS_PROFILE.
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud: select per process with TEMPORAL_TARGET=cloud and set TEMPORAL_ADDRESS/TEMPORAL_NAMESPACE
# to the Cloud values below (API-key auth; the key is never logged).
# TEMPORAL_TARGET=local
TEMPORAL_CLOUD_API_KEY=
TEMPORAL_CLOUD_ADDRESS=us-east-1.aws.api.temporal.io:7233
TEMPORAL_CLOUD_NAMESPACE=mission-control-dev.ih0e7
TEMPORAL_CLOUD_NAMESPACE_PROD=mission-control-prod.ih0e7
TEMPORAL_TASK_QUEUE=biotech-research-ingestion
# OC-R4: the installation's application id selects deployments/<app>/application.toml, whose
# [installation] table supplies TEMPORAL_TASK_QUEUE, LANGSMITH_PROJECT,
# AGENT_SERVER_LANGSMITH_PROJECT and MISSION_CONTROL_WORKSPACE_ROOT when they are unset.
# REQUIRED for live scripts, the local worker and the technical API: set
# MISSION_CONTROL_APPLICATION, or both MISSION_CONTROL_WORKSPACE_ROOT and TEMPORAL_TASK_QUEUE;
# there are no defaults (startup fails with InstallationDefaultUnavailable). A configured
# deployment's TEMPORAL_TASK_QUEUE must equal its installation queue base, or startup refuses.
# MISSION_CONTROL_APPLICATION=biotech
# MISSION_CONTROL_DEPLOYMENTS_ROOT=
# OC-R6: the Agent Server's technical child runs on deployments/<app>/models.toml `child.default`
# (Anthropic today), so the Agent Server environment needs MISSION_CONTROL_APPLICATION, the
# deployments root above and ANTHROPIC_API_KEY; re-run `missionctl lane async-graphs` after any
# change of that row (the served graph digest follows it).
SANDBOX_IMAGE=python:3.12-slim
API_HOST=127.0.0.1
API_PORT=8000
SOCKETIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted installation catalog key for fresh PostgreSQL-backed runtime executions.
# Set from deployment configuration; never accept it from an HTTP request.
MISSION_CONTROL_CATALOG_SCOPE=

# Skill directory custody: local offline store, or admitted Supabase capability-bundles.
# Supabase mode requires migration0033 and prior operator registration of every skill pin.
# Namespace is deployment-owned; never resolve it from mission inputs.
CAPABILITY_BUNDLE_BACKEND=local
CAPABILITY_BUNDLE_NAMESPACE=
# CAPABILITY_BUNDLE_LOCAL_ROOT=/absolute/service-owned/capability-bundles

# Mission Control GitHub App (per-run, repo-scoped installation tokens). Key file lives outside every repo.
MC_GITHUB_APP_ID=
MC_GITHUB_APP_INSTALLATION_ID=
MC_GITHUB_APP_PRIVATE_KEY_PATH=
