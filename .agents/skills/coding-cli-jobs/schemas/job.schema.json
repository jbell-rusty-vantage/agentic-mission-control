{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "cli": {
      "enum": [
        "claude",
        "codex",
        "cursor"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string"
    },
    "host": {
      "enum": [
        "auto",
        "native",
        "wsl"
      ]
    },
    "permissions": {
      "enum": [
        "read-only",
        "edit",
        "full"
      ]
    },
    "auth": {
      "enum": [
        "subscription",
        "api"
      ]
    },
    "context_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "enum": [
            null,
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": []
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "git",
            "native",
            "none"
          ]
        },
        "base": {
          "type": "string"
        },
        "keep": {
          "enum": [
            "always",
            "on_change"
          ]
        }
      },
      "required": []
    },
    "done_when": {
      "oneOf": [
        {
          "enum": [
            "verify_pass_and_agent_done",
            "verify_pass",
            "agent_done"
          ]
        },
        {
          "type": "string",
          "pattern": "^schema:\\$(?:\\.[A-Za-z_][A-Za-z0-9_-]*|\\[(?:0|[1-9][0-9]*)\\])+$"
        }
      ]
    },
    "output_schema": {
      "type": [
        "object",
        "null"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_turns_per_iteration": {
          "type": "integer",
          "minimum": 1
        },
        "wall_clock_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "required": []
    },
    "wsl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distro",
        "repo",
        "worktree_root",
        "home",
        "path",
        "binary"
      ],
      "properties": {
        "distro": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "worktree_root": {
          "type": "string",
          "minLength": 1
        },
        "home": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "binary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "id",
    "cli",
    "goal"
  ]
}
